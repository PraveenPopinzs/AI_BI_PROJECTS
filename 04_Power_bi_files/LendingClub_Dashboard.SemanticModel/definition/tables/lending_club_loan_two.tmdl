	column 'Credit History Years' =
			
			DATEDIFF(
			    lending_club_loan_two[earliest_credit_line_date],
			    lending_club_loan_two[issue_date],
			    MONTH
			)
		formatString: 0
		lineageTag: 62200b2a-88cd-4f87-84f6-adbc82142256
		summarizeBy: sum

		annotation SummarizationSetBy = Automatic

	partition lending_club_loan_two = m
		mode: import
		source =
				let
					Source = Csv.Document(File.Contents("C:\Popinzs\Projects\Power BI Projects\Bank Loan Analytical Project\04_Power_bi_files\Files\lending_club_loan_two.csv"), [Delimiter=",", Columns=27, Encoding=1252, QuoteStyle=QuoteStyle.Csv]),
					#"Promoted Headers" = Table.PromoteHeaders(Source, [PromoteAllScalars=true]),
					#"Removed Address" = Table.RemoveColumns(#"Promoted Headers", {"address"}),
					TextColumns = {"term", "grade", "sub_grade", "emp_title", "emp_length", "home_ownership", "verification_status", "loan_status", "purpose", "title", "initial_list_status", "application_type"},
					#"Trimmed and Cleaned Text" = Table.TransformColumns(
						#"Removed Address",
						List.Transform(
							TextColumns,
							(ColumnName) => {
								ColumnName,
								(Value) => if Value = null then null else Text.Clean(Text.Trim(Value)),
								type nullable text
							}
						)
					),
					#"Empty Strings to Null" = Table.ReplaceValue(
						#"Trimmed and Cleaned Text",
						"",
						null,
						Replacer.ReplaceValue,
						List.Combine({TextColumns, {"mort_acc", "revol_util", "pub_rec_bankruptcies"}})
					),
					#"Changed Type" = Table.TransformColumnTypes(
						#"Empty Strings to Null",
						{
							{"loan_amnt", type number},
							{"term", type text},
							{"int_rate", type number},
							{"installment", type number},
							{"grade", type text},
							{"sub_grade", type text},
							{"emp_title", type text},
							{"emp_length", type text},
							{"home_ownership", type text},
							{"annual_inc", type number},
							{"verification_status", type text},
							{"issue_d", type date},
							{"loan_status", type text},
							{"purpose", type text},
							{"title", type text},
							{"dti", type number},
							{"earliest_cr_line", type date},
							{"open_acc", Int64.Type},
							{"pub_rec", Int64.Type},
							{"revol_bal", type number},
							{"revol_util", type number},
							{"total_acc", Int64.Type},
							{"initial_list_status", type text},
							{"application_type", type text},
							{"mort_acc", Int64.Type},
							{"pub_rec_bankruptcies", Int64.Type}
						}
					),
					#"Added Term Months" = Table.AddColumn(
						#"Changed Type",
						"Term_Months",
						each if [term] = null then null else Number.FromText(Text.BeforeDelimiter([term], " ")),
						Int64.Type
					),
					#"Added Loan Status Category" = Table.AddColumn(
						#"Added Term Months",
						"Loan_Status_Category",
						each
							if [loan_status] = null then null
							else if [loan_status] = "Fully Paid" then "Good Loan"
							else if [loan_status] = "Charged Off" then "Bad Loan"
							else "Other",
						type text
					),
					#"Added Issue Month" = Table.AddColumn(
						#"Added Loan Status Category",
						"Issue_Month",
						each if [issue_d] = null then null else Date.Month([issue_d]),
						Int64.Type
					),
					#"Added Issue Year" = Table.AddColumn(
						#"Added Issue Month",
						"Issue_Year",
						each if [issue_d] = null then null else Date.Year([issue_d]),
						Int64.Type
					),
					#"Added Employment Length Years" = Table.AddColumn(
						#"Added Issue Year",
						"Employment_Length_Years",
						each
							if [emp_length] = null then null
							else if [emp_length] = "< 1 year" then 0
							else if [emp_length] = "10+ years" then 10
							else Number.FromText(Text.BeforeDelimiter([emp_length], " ")),
						Int64.Type
					),
					#"Added Income Group" = Table.AddColumn(
						#"Added Employment Length Years",
						"Income_Group",
						each
							if [annual_inc] = null or [annual_inc] <= 0 then "Unknown"
							else if [annual_inc] < 30000 then "Low Income"
							else if [annual_inc] < 60000 then "Medium Income"
							else if [annual_inc] < 100000 then "High Income"
							else "Very High Income",
						type text
					),
					#"Added Loan ID" = Table.AddIndexColumn(#"Added Income Group", "Loan_ID", 1, 1, Int64.Type),
					#"Renamed Columns" = Table.RenameColumns(
						#"Added Loan ID",
						{
							{"loan_amnt", "loan_amount"},
							{"term", "loan_term"},
							{"int_rate", "interest_rate"},
							{"installment", "installment_amount"},
							{"grade", "loan_grade"},
							{"sub_grade", "loan_sub_grade"},
							{"emp_title", "employment_title"},
							{"emp_length", "employment_length"},
							{"annual_inc", "annual_income"},
							{"issue_d", "issue_date"},
							{"purpose", "loan_purpose"},
							{"title", "loan_title"},
							{"dti", "debt_to_income_ratio"},
							{"earliest_cr_line", "earliest_credit_line_date"},
							{"open_acc", "open_accounts"},
							{"pub_rec", "public_records"},
							{"revol_bal", "revolving_balance"},
							{"revol_util", "revolving_utilization"},
							{"total_acc", "total_accounts"},
							{"mort_acc", "mortgage_accounts"},
							{"pub_rec_bankruptcies", "public_record_bankruptcies"},
							{"Term_Months", "loan_term_months"},
							{"Loan_Status_Category", "loan_status_category"},
							{"Issue_Month", "issue_month"},
							{"Issue_Year", "issue_year"},
							{"Employment_Length_Years", "employment_length_years"}
						}
					),
				    #"Replaced Value" = Table.ReplaceValue(#"Renamed Columns",null,"Unknown",Replacer.ReplaceValue,{"employment_length"})
				in
				    #"Replaced Value"

	annotation PBI_ResultType = Table

